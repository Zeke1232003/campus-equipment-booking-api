{
  "name": "campus-equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:reset": "tsx scripts/init-db.ts --reset-bookings",
    "test": "tsx scripts/test-api.ts",
    "test:preparation": "node scripts/verify-preparation.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
