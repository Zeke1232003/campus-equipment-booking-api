    },
    {
      "name": "03 Create booking (save ID automatically)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"eq-1\",\n  \"borrowerName\": \"Somchai Jaidee\",\n  \"startAt\": \"2026-10-20T09:00:00.000Z\",\n  \"endAt\": \"2026-10-20T11:00:00.000Z\",\n  \"purpose\": \"Class presentation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"bookingId\"); pm.environment.unset(\"expectedBooking\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON Content-Type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json/i); });",
              "if (pm.response.code === 201) {",
              " const data = pm.response.json();",
              " if (typeof data.id === \"string\" && data.id.length) {",
              "  pm.environment.set(\"bookingId\", data.id);",
              "  pm.environment.set(\"expectedBooking\", pm.request.body.raw);",
              " }",
              "}",
              "const booking = pm.response.json();",
              "pm.test(\"Booking has required fields and values\", function () {",
              "  pm.expect(booking.id).to.be.a(\"string\").and.not.empty;",
              "  const expected = JSON.parse(pm.environment.get(\"expectedBooking\"));",
              "  for (const key of [\"equipmentId\", \"borrowerName\", \"startAt\", \"endAt\", \"purpose\"]) pm.expect(booking[key], key).to.eql(expected[key]);",
              "  pm.expect(booking.id).to.eql(pm.environment.get(\"bookingId\"));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
