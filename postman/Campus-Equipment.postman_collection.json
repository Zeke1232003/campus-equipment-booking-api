{
  "info": {
    "name": "Campus Equipment — Instructor Quality Gate",
    "description": "Select Campus Equipment Local environment. Run in order against a seeded disposable local database with no bookings. Includes nine instructor steps plus persistence and deletion follow-ups. Local TypeScript/Hono/SQLite API implemented; this collection passed 14 requests and 41 assertions in Newman. Record your own Postman results separately.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 List equipment",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/equipment",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "equipment"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"bookingId\"); pm.environment.unset(\"expectedBooking\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON Content-Type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json/i); });",
              "pm.test(\"At least two seeded equipment records\", function () { const data = pm.response.json(); pm.expect(data).to.be.an(\"array\"); pm.expect(data.length).to.be.at.least(2); for (const id of [\"eq-1\", \"eq-2\"]) pm.expect(data.some(x => x.id === id && typeof x.name === \"string\" && typeof x.location === \"string\")).to.eql(true); });"
            ]
          }
        }
      ],
      "response": []
    },
