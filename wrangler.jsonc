{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-equipment-booking-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
